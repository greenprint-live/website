{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "module": "esnext",
        "target": "es2022",
        "moduleResolution": "bundler",
        "types": ["node", "vite/client"],
        "baseUrl": ".",
        "paths": {
            "$lib": ["svelte"],
            "$lib/*": ["svelte/*"]
        }
    },
    "exclude": [
        "node_modules/**/*",
        "eslint.config.mjs",
        "svelte.config.js",
        "vite.build.js",
        "vite.client.config.js",
        "vite.server.config.js",
        "build.js"
    ]
}
